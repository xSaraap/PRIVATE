function Library:_newSlider(tab, label, description, default, isPercent, callback)
    local card = makeCard(tab.Page, 70)
    local min, max = 0, 200
    local value = default or 100

    new("TextLabel", {
        Size = UDim2.new(1, -70, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })

    local valLbl = new("TextLabel", {
        Size = UDim2.new(0, 50, 0, 18),
        Position = UDim2.new(1, -62, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = Theme.Accent,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = card,
    })

    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 14),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = description or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })

    local track = new("Frame", {
        Size = UDim2.new(1, -24, 0, 8),
        Position = UDim2.new(0, 12, 0, 50),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(track, 4)

    local fill = new("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, 4)

    local knob = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((value - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track,
    })
    corner(knob, 7)
    stroke(knob, Theme.Accent, 2)

    local dragging = false
    local function updateFromX(mouseX)
        local trackPos = track.AbsolutePosition.X
        local trackSize = track.AbsoluteSize.X
        local rel = math.clamp((mouseX - trackPos) / trackSize, 0, 1)
        local newVal = math.floor(min + rel * (max - min))
        value = newVal
        valLbl.Text = tostring(value)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -7, 0.5, -7)
        if callback then callback(value) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return card
end

function Library:_newDropdown(tab, label, description, options, callback)
    local card = makeCard(tab.Page, 62)
    local listOpen = false

    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })

    local selBox = new("TextButton", {
        Size = UDim2.new(1, -24, 0, 24),
        Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        Text = "Select...",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 12,
        AutoButtonColor = false,
        Parent = card,
    })
    corner(selBox, 6)

    local popup = new("Frame", {
        Size = UDim2.new(1, -24, 0, #options * 26 + 8),
        Position = UDim2.new(0, 12, 1, 4),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 10,
        Parent = card,
    })
    corner(popup, 6)
    stroke(popup, Theme.Border, 1)

    new("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = popup,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4),
        Parent = popup,
    })

    local function closePopup()
        listOpen = false
        popup.Visible = false
        card.Size = UDim2.new(1, 0, 0, 62)
    end

    local function openPopup()
        listOpen = true
        popup.Visible = true
        card.Size = UDim2.new(1, 0, 0, 62 + #options * 26 + 12)
    end

    for i, opt in ipairs(options) do
        local optBtn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundColor3 = Theme.PanelLight,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = tostring(opt),
            TextColor3 = Theme.Text,
            Font = Theme.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = i,
            AutoButtonColor = false,
            Parent = popup,
        })

        optBtn.MouseEnter:Connect(function()
            tween(optBtn, 0.1, { BackgroundTransparency = 0, BackgroundColor3 = Theme.Accent })
        end)
        optBtn.MouseLeave:Connect(function()
            tween(optBtn, 0.1, { BackgroundTransparency = 1 })
        end)

        optBtn.MouseButton1Click:Connect(function()
            selBox.Text = tostring(opt)
            selBox.TextColor3 = Theme.Text
            closePopup()
            if callback then callback(opt) end
        end)
    end

    selBox.MouseButton1Click:Connect(function()
        if listOpen then closePopup() else openPopup() end
    end)

    return card
end

return Library
