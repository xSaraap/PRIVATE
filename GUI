-- ELEMENTS
-- ============================================================
local function makeCard(page, height)
    local card = new("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = page,
    })
    corner(card, 8)
    stroke(card, Theme.Border, 1)
    return card
end

function VBHUB:_makeInput(page, label, placeholder, callback)
    local card = makeCard(page, 62)
    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 14),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = placeholder or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    local box = new("Frame", {
        Size = UDim2.new(1, -24, 0, 24),
        Position = UDim2.new(0, 12, 0, 42),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(box, 6)
    local input = new("TextBox", {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "Input Here...",
        PlaceholderColor3 = Theme.TextDim,
        TextColor3 = Theme.Text,
        Font = Theme.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false,
        Parent = box,
    })
    input.Focused:Connect(function() tween(box, 0.1, { BackgroundColor3 = Theme.InputFocus }) end)
    input.FocusLost:Connect(function()
        tween(box, 0.1, { BackgroundColor3 = Theme.Input })
        if callback then callback(input.Text) end
    end)
    return card
end

function VBHUB:_makeToggle(page, label, description, default, callback)
    local card = makeCard(page, 58)
    local enabled = default and true or false

    new("TextLabel", {
        Size = UDim2.new(1, -80, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -80, 0, 28),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = description or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = card,
    })
    local switch = new("TextButton", {
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -52, 0.5, -11),
        BackgroundColor3 = enabled and Theme.Accent or Theme.ToggleOff,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = card,
    })
    corner(switch, 11)
    local knob = new("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = enabled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = switch,
    })
    corner(knob, 9)
    switch.MouseButton1Click:Connect(function()
        enabled = not enabled
        tween(switch, 0.15, { BackgroundColor3 = enabled and Theme.Accent or Theme.ToggleOff })
        tween(knob, 0.15, {
            Position = enabled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        })
        if callback then callback(enabled) end
    end)
    return card
end

function VBHUB:_makeButton(page, label, description, callback)
    local card = makeCard(page, 50)
    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = card,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 14),
        Position = UDim2.new(0, 12, 0, 28),
        BackgroundTransparency = 1,
        Text = description or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    btn.MouseEnter:Connect(function() tween(card, 0.1, { BackgroundColor3 = Theme.PanelLight }) end)
    btn.MouseLeave:Connect(function() tween(card, 0.1, { BackgroundColor3 = Theme.Panel }) end)
    btn.MouseButton1Click:Connect(function() if callback then callback() end end)
    return card
end

function VBHUB:_makeSlider(page, label, description, default, isPercent, callback)
    local card = makeCard(page, 70)
    local min, max = 0, 200
    local value = default or 100

    new("TextLabel", {
        Size = UDim2.new(1, -70, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    local valLbl = new("TextLabel", {
        Size = UDim2.new(0, 50, 0, 18),
        Position = UDim2.new(1, -62, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = Theme.Accent,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = card,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 14),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = description or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    local track = new("Frame", {
        Size = UDim2.new(1, -24, 0, 8),
        Position = UDim2.new(0, 12, 0, 50),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(track, 4)
    local fill = new("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, 4)
    local knob = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((value - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track,
    })
    corner(knob, 7)
    stroke(knob, Theme.Accent, 2)

    local dragging = false
    local function updateFromX(mouseX)
        local tp = track.AbsolutePosition.X
        local ts = track.AbsoluteSize.X
        if ts <= 0 then return end
        local rel = math.clamp((mouseX - tp) / ts, 0, 1)
        local v = math.floor(min + rel * (max - min))
        value = v
        valLbl.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -7, 0.5, -7)
        if callback then callback(v) end
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return card
end

function VBHUB:_makeDropdown(page, label, description, options, callback)
    local card = makeCard(page, 62)
    local listOpen = false

    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    local selBox = new("TextButton", {
        Size = UDim2.new(1, -24, 0, 24),
        Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        Text = "Select...",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 12,
        AutoButtonColor = false,
        Parent = card,
    })
    corner(selBox, 6)
    local popup = new("Frame", {
        Size = UDim2.new(1, -24, 0, #options * 26 + 8),
        Position = UDim2.new(0, 12, 1, 4),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 10,
        Parent = card,
    })
    corner(popup, 6)
    stroke(popup, Theme.Border, 1)
    new("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = popup,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        Parent = popup,
    })
    local function closePopup()
        listOpen = false
        popup.Visible = false
        card.Size = UDim2.new(1, 0, 0, 62)
    end
    local function openPopup()
        listOpen = true
        popup.Visible = true
        card.Size = UDim2.new(1, 0, 0, 62 + #options * 26 + 12)
    end
    for i, opt in ipairs(options) do
        local ob = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundColor3 = Theme.PanelLight,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = tostring(opt),
            TextColor3 = Theme.Text,
            Font = Theme.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = i,
            AutoButtonColor = false,
            Parent = popup,
        })
        ob.MouseEnter:Connect(function()
            tween(ob, 0.1, { BackgroundTransparency = 0, BackgroundColor3 = Theme.Accent })
        end)
        ob.MouseLeave:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 1 }) end)
        ob.MouseButton1Click:Connect(function()
            selBox.Text = tostring(opt)
            selBox.TextColor3 = Theme.Text
            closePopup()
            if callback then callback(opt) end
        end)
    end
    selBox.MouseButton1Click:Connect(function()
        if listOpen then closePopup() else openPopup() end
    end)
    return card
end

return VBHUB
