-- VBHUB UI Library v1.1 (fixed)
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")

local function getGuiParent()
    local ok, res = pcall(function()
        if gethui then return gethui() end
        return CoreGui
    end)
    if ok and res then return res end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local Library = {}
Library.__index = Library

local Theme = {
    Background  = Color3.fromRGB(18, 18, 22),
    Panel       = Color3.fromRGB(24, 24, 30),
    PanelLight  = Color3.fromRGB(32, 32, 40),
    Border      = Color3.fromRGB(45, 45, 55),
    Accent      = Color3.fromRGB(140, 90, 255),
    Text        = Color3.fromRGB(240, 240, 245),
    TextDim     = Color3.fromRGB(150, 150, 165),
    ToggleOff   = Color3.fromRGB(60, 60, 70),
    ToggleOn    = Color3.fromRGB(140, 90, 255),
    Input       = Color3.fromRGB(30, 30, 38),
    InputFocus  = Color3.fromRGB(40, 40, 52),
    Danger      = Color3.fromRGB(220, 70, 70),
    Font        = Enum.Font.Gotham,
    FontBold    = Enum.Font.GothamBold,
}

local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function corner(parent, radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = parent })
end

local function stroke(parent, color, thickness)
    return new("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function tween(inst, time, props)
    local t = TweenService:Create(inst,
        TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- ============ LOAD ============
function Library:Load(title, subtitle)
    if self.Main then return self end

    local parent = getGuiParent()

    local screenGui = new("ScreenGui", {
        Name = "VBHUB",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        Parent = parent,
    })
    self.ScreenGui = screenGui

    local main = new("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 560, 0, 420),
        Position = UDim2.new(0.5, -280, 0.5, -210),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = screenGui,
        Active = true,
    })
    corner(main, 10)
    stroke(main, Theme.Border, 1)
    self.Main = main

    -- Sidebar
    local sidebar = new("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, 150, 1, 0),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = main,
    })
    corner(sidebar, 10)

    -- Header
    new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.new(0, 14, 0, 16),
        BackgroundTransparency = 1,
        Text = title or "VBHUB",
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 17,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sidebar,
    })

    new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 16),
        Position = UDim2.new(0, 14, 0, 38),
        BackgroundTransparency = 1,
        Text = subtitle or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sidebar,
    })

    -- Divider under header
    local divider = new("Frame", {
        Size = UDim2.new(1, -16, 0, 1),
        Position = UDim2.new(0, 8, 0, 62),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,
        Parent = sidebar,
    })

    -- Tab container
    local tabHolder = new("ScrollingFrame", {
        Name = "Tabs",
        Size = UDim2.new(1, -16, 1, -78),
        Position = UDim2.new(0, 8, 0, 70),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = sidebar,
    })

    new("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = tabHolder,
    })

    -- Content area
    local content = new("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -160, 1, -20),
        Position = UDim2.new(0, 160, 0, 10),
        BackgroundTransparency = 1,
        Parent = main,
    })

    self.TabHolder = tabHolder
    self.Content = content
    self.ActiveTab = nil
    self.TabCount = 0

    -- Drag bar
    local dragBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        Parent = main,
    })

    -- Close button
    local closeBtn = new("TextButton", {
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(1, -34, 0, 8),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        Text = "×",
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 18,
        AutoButtonColor = false,
        Parent = main,
        ZIndex = 5,
    })
    corner(closeBtn, 6)
    closeBtn.MouseEnter:Connect(function()
        tween(closeBtn, 0.1, { BackgroundColor3 = Theme.Danger })
    end)
    closeBtn.MouseLeave:Connect(function()
        tween(closeBtn, 0.1, { BackgroundColor3 = Theme.PanelLight })
    end)
    closeBtn.MouseButton1Click:Connect(function()
        screenGui.Enabled = false
    end)

    -- UI visibility toggle (Right Control)
    local uiVisible = true
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.RightControl then
            uiVisible = not uiVisible
            screenGui.Enabled = uiVisible
        end
    end)

    -- Dragging
    local dragging, dragStart, startPos
    dragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return self
end

-- ============ TAB ============
function Library:newTab(name, icon)
    local self2 = self
    local order = self.TabCount
    self.TabCount = self.TabCount + 1

    -- Sidebar button
    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = order,
        Parent = self.TabHolder,
    })
    corner(btn, 6)

    local btnLbl = new("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })

    local indicator = new("Frame", {
        Size = UDim2.new(0, 3, 0, 18),
        Position = UDim2.new(0, 6, 0.5, -9),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Visible = false,
        Parent = btn,
    })
    corner(indicator, 2)

    -- Content page
    local page = new("ScrollingFrame", {
        Name = "Page_" .. name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.Content,
    })

    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = page,
    })

    new("UIPadding", {
        PaddingRight = UDim.new(0, 6),
        Parent = page,
    })

    local tab = {
        Library = self,
        Name = name,
        Button = btn,
        Label = btnLbl,
        Indicator = indicator,
        Page = page,
    }

    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.1, { BackgroundColor3 = Theme.PanelLight })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.1, { BackgroundColor3 = Theme.Panel })
        end
    end)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    -- Return tab with element methods mixed in
    local tabMethods = {}
    tabMethods.newInput = function(_, label, placeholder, callback)
        return self2:_newInput(tab, label, placeholder, callback)
    end
    tabMethods.newToggle = function(_, label, description, default, callback)
        return self2:_newToggle(tab, label, description, default, callback)
    end
    tabMethods.newButton = function(_, label, description, callback)
        return self2:_newButton(tab, label, description, callback)
    end
    tabMethods.newSlider = function(_, label, description, default, isPercent, callback)
        return self2:_newSlider(tab, label, description, default, isPercent, callback)
    end
    tabMethods.newDropdown = function(_, label, description, options, callback)
        return self2:_newDropdown(tab, label, description, options, callback)
    end
    tabMethods.newLabel = function(_, text)
        return self2:_newLabel(tab, text)
    end

    return setmetatable(tabMethods, {
        __index = tab,
        __newindex = function(t, k, v) tab[k] = v end,
    })
end

function Library:SelectTab(tab)
    if self.ActiveTab == tab then return end
    if self.ActiveTab then
        self.ActiveTab.Page.Visible = false
        tween(self.ActiveTab.Button, 0.15, { BackgroundColor3 = Theme.Panel })
        self.ActiveTab.Label.TextColor3 = Theme.TextDim
        self.ActiveTab.Indicator.Visible = false
    end
    self.ActiveTab = tab
    tab.Page.Visible = true
    tween(tab.Button, 0.15, { BackgroundColor3 = Theme.PanelLight })
    tab.Label.TextColor3 = Theme.Text
    tab.Indicator.Visible = true
end

-- ============ ELEMENTS ============
local function makeCard(parent, height)
    local card = new("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(card, 8)
    stroke(card, Theme.Border, 1)
    return card
end

function Library:_newLabel(tab, text)
    local card = makeCard(tab.Page, 32)
    new("TextLabel", {
        Size = UDim2.new(1, -24, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    return card
end

function Library:_newInput(tab, label, placeholder, callback)
    local card = makeCard(tab.Page, 62)

    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })

    new("TextLabel", {
        Size = UDim2.new(1, -24, 0, 14),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = placeholder or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })

    local box = new("Frame", {
        Size = UDim2.new(1, -24, 0, 24),
        Position = UDim2.new(0, 12, 0, 42),
        BackgroundColor3 = Theme.Input,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(box, 6)

    local input = new("TextBox", {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "Input Here...",
        PlaceholderColor3 = Theme.TextDim,
        TextColor3 = Theme.Text,
        Font = Theme.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false,
        Parent = box,
    })

    input.Focused:Connect(function()
        tween(box, 0.1, { BackgroundColor3 = Theme.InputFocus })
    end)
    input.FocusLost:Connect(function()
        tween(box, 0.1, { BackgroundColor3 = Theme.Input })
        if callback then callback(input.Text) end
    end)

    return card
end

function Library:_newToggle(tab, label, description, default, callback)
    local card = makeCard(tab.Page, 58)
    local enabled = default and true or false

    new("TextLabel", {
        Size = UDim2.new(1, -80, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })

    new("TextLabel", {
        Size = UDim2.new(1, -80, 0, 28),
        Position = UDim2.new(0, 12, 0, 26),
        BackgroundTransparency = 1,
        Text = description or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = card,
    })

    local switch = new("TextButton", {
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -52, 0.5, -11),
        BackgroundColor3 = enabled and Theme.ToggleOn or Theme.ToggleOff,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = card,
    })
    corner(switch, 11)

    local knob = new("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = enabled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = switch,
    })
    corner(knob, 9)

    switch.MouseButton1Click:Connect(function()
        enabled = not enabled
        tween(switch, 0.15, {
            BackgroundColor3 = enabled and Theme.ToggleOn or Theme.ToggleOff
        })
        tween(knob, 0.15, {
            Position = enabled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        })
        if callback then callback(enabled) end
    end)

    return card
end

