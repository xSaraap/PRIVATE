-- VBHUB UI Library v2.1 (bulletproof layout)
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")

local function getGuiParent()
    local ok, res = pcall(function()
        if gethui then return gethui() end
        return CoreGui
    end)
    if ok and res then return res end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local Theme = {
    Background  = Color3.fromRGB(18, 18, 22),
    Panel       = Color3.fromRGB(24, 24, 30),
    PanelLight  = Color3.fromRGB(32, 32, 40),
    Border      = Color3.fromRGB(45, 45, 55),
    Accent      = Color3.fromRGB(140, 90, 255),
    Text        = Color3.fromRGB(240, 240, 245),
    TextDim     = Color3.fromRGB(150, 150, 165),
    ToggleOff   = Color3.fromRGB(60, 60, 70),
    Input       = Color3.fromRGB(30, 30, 38),
    InputFocus  = Color3.fromRGB(40, 40, 52),
    Danger      = Color3.fromRGB(220, 70, 70),
    Font        = Enum.Font.Gotham,
    FontBold    = Enum.Font.GothamBold,
}

local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end
local function corner(p, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = p })
end
local function stroke(p, c, t)
    return new("UIStroke", {
        Color = c or Theme.Border, Thickness = t or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
    })
end
local function tween(inst, time, props)
    TweenService:Create(inst,
        TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local VBHUB = {}
VBHUB.__index = VBHUB

-- Fixed dimensions — no dynamic layout
local WIN_W, WIN_H = 560, 420
local SIDEBAR_W = 150
local TAB_H = 34
local TAB_GAP = 6
local TAB_START_Y = 70

function VBHUB:Load(title, subtitle)
    if self.Main then return self end
    self.Tabs = {}
    self.TabCount = 0
    self.ActiveTab = nil

    local screenGui = new("ScreenGui", {
        Name = "VBHUB",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        Parent = getGuiParent(),
    })
    self.ScreenGui = screenGui

    -- ===== MAIN WINDOW =====
    local main = new("Frame", {
        Size = UDim2.new(0, WIN_W, 0, WIN_H),
        Position = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = screenGui,
        Active = true,
    })
    corner(main, 10)
    stroke(main, Theme.Border, 1)
    self.Main = main

    -- ===== SIDEBAR =====
    local sidebar = new("Frame", {
        Size = UDim2.new(0, SIDEBAR_W, 1, 0),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = main,
    })
    corner(sidebar, 10)
    -- Hides the right-side rounded corners of sidebar
    new("Frame", {
        Size = UDim2.new(0, 20, 1, 0),
        Position = UDim2.new(1, -20, 0, 0),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = sidebar,
    })

    -- Header
    new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.new(0, 14, 0, 16),
        BackgroundTransparency = 1,
        Text = title or "VBHUB",
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 17,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sidebar,
    })
    new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 16),
        Position = UDim2.new(0, 14, 0, 38),
        BackgroundTransparency = 1,
        Text = subtitle or "",
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sidebar,
    })
    -- Divider
    new("Frame", {
        Size = UDim2.new(1, -16, 0, 1),
        Position = UDim2.new(0, 8, 0, 62),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,
        Parent = sidebar,
    })

    self.Sidebar = sidebar

    -- ===== CONTENT AREA =====
    local content = new("Frame", {
        Size = UDim2.new(1, -SIDEBAR_W - 10, 1, -20),
        Position = UDim2.new(0, SIDEBAR_W + 10, 0, 10),
        BackgroundTransparency = 1,
        Parent = main,
    })
    self.Content = content

    -- ===== DRAG BAR =====
    local dragBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        Parent = main,
    })

    -- ===== CLOSE BUTTON =====
    local closeBtn = new("TextButton", {
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(1, -34, 0, 8),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        Text = "×",
        TextColor3 = Theme.Text,
        Font = Theme.FontBold,
        TextSize = 18,
        AutoButtonColor = false,
        Parent = main,
        ZIndex = 5,
    })
    corner(closeBtn, 6)
    closeBtn.MouseEnter:Connect(function() tween(closeBtn, 0.1, { BackgroundColor3 = Theme.Danger }) end)
    closeBtn.MouseLeave:Connect(function() tween(closeBtn, 0.1, { BackgroundColor3 = Theme.PanelLight }) end)
    closeBtn.MouseButton1Click:Connect(function() screenGui.Enabled = false end)

    -- ===== RIGHT CTRL TOGGLE =====
    local uiVisible = true
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.RightControl then
            uiVisible = not uiVisible
            screenGui.Enabled = uiVisible
        end
    end)

    -- ===== DRAG LOGIC =====
    local dragging, dragStart, startPos
    dragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return self
end

-- ============================================================
function VBHUB:newTab(name, icon)
    local index = self.TabCount
    self.TabCount = self.TabCount + 1

    -- ==== TAB BUTTON (fixed position, no layout!) ====
    local btn = new("TextButton", {
        Size = UDim2.new(0, SIDEBAR_W - 24, 0, TAB_H),
        Position = UDim2.new(0, 12, 0, TAB_START_Y + index * (TAB_H + TAB_GAP)),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = self.Sidebar,
        ZIndex = 2,
    })
    corner(btn, 6)

    local btnLbl = new("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.TextDim,
        Font = Theme.Font,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })

    local indicator = new("Frame", {
        Size = UDim2.new(0, 3, 0, 18),
        Position = UDim2.new(0, 4, 0.5, -9),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Visible = false,
        Parent = btn,
    })
    corner(indicator, 2)

    -- ==== PAGE (fixed size, no scroll layout) ====
    local page = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = self.Content,
    })

    -- A UIListLayout inside the page for stacking cards
    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = page,
    })

    local tab = {
        Name = name,
        Button = btn,
        Label = btnLbl,
        Indicator = indicator,
        Page = page,
        Library = self,
        PageLayout = page:FindFirstChildOfClass("UIListLayout"),
    }

    -- Click handlers
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.1, { BackgroundColor3 = Theme.PanelLight })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.1, { BackgroundColor3 = Theme.Panel })
        end
    end)

    -- Auto-select first tab
    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    table.insert(self.Tabs, tab)

    -- ==== ELEMENT METHODS ====
    local lib = self
    tab.newInput = function(_, label, placeholder, callback)
        return lib:_makeInput(page, label, placeholder, callback)
    end
    tab.newToggle = function(_, label, description, default, callback)
        return lib:_makeToggle(page, label, description, default, callback)
    end
    tab.newButton = function(_, label, description, callback)
        return lib:_makeButton(page, label, description, callback)
    end
    tab.newSlider = function(_, label, description, default, isPercent, callback)
        return lib:_makeSlider(page, label, description, default, isPercent, callback)
    end
    tab.newDropdown = function(_, label, description, options, callback)
        return lib:_makeDropdown(page, label, description, options, callback)
    end

    return tab
end

function VBHUB:SelectTab(tab)
    if self.ActiveTab == tab then return end
    if self.ActiveTab then
        self.ActiveTab.Page.Visible = false
        tween(self.ActiveTab.Button, 0.15, { BackgroundColor3 = Theme.Panel })
        self.ActiveTab.Label.TextColor3 = Theme.TextDim
        self.ActiveTab.Indicator.Visible = false
    end
    self.ActiveTab = tab
    tab.Page.Visible = true
    tween(tab.Button, 0.15, { BackgroundColor3 = Theme.PanelLight })
    tab.Label.TextColor3 = Theme.Text
    tab.Indicator.Visible = true
end

