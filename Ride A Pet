-- 15. RETURN POSITION
--============================================================

local function GetReturnPosition()
    if Config.SavedPoint then return Config.SavedPoint.Position end
    return GetPlotPosition()
end

--============================================================
-- 16. PICKUP
--============================================================

local function GetBasketCount()
    local Basket = Player:FindFirstChild("Basket")
    if not Basket then return 0 end
    return #Basket:GetChildren()
end

local function PickupEgg(Egg)
    if not Egg or not GameRemotes then return false end

    local Remote = GameRemotes:FindFirstChild("EggPickup")
    if not Remote then return false end

    local Before = GetBasketCount()

    pcall(function()
        if Remote:IsA("RemoteEvent") then
            Remote:FireServer(Egg.Object.Name)
        elseif Remote:IsA("RemoteFunction") then
            Remote:InvokeServer(Egg.Object.Name)
        end
    end)

    local EndTime = os.clock() + 2
    while os.clock() < EndTime do
        if Config.Stop then return false end
        if GetBasketCount() > Before then return true end
        task.wait(0.05)
    end
    return false
end

--============================================================
-- 17. RETURN HOME
--============================================================

local function ReturnHome()
    local Target = GetReturnPosition()
    if not Target then return false end
    if Config.StealMode == "Teleport" then
        return TeleportTo(Target)
    else
        return FlyTo(Target)
    end
end

--============================================================
-- 18. AUTO STEAL LOOP
--============================================================

local function AutoStealLoop()
    if Config.Busy then return end
    Config.Busy = true
    Config.Stop = false

    task.spawn(function()
        while Config.AutoSteal do
            if Config.Stop then break end

            local BestEgg = FindBestEgg()
            if not BestEgg then task.wait(0.4); continue end
            if not BestEgg.Object or not BestEgg.Object.Parent then
                task.wait(0.1); continue
            end

            local EggPosition = BestEgg.Position + Vector3.new(0, 3, 0)

            local Reached = false
            if Config.StealMode == "Teleport" then
                Reached = TeleportTo(EggPosition)
            else
                Reached = FlyTo(EggPosition)
            end

            if not Reached then task.wait(0.25); continue end

            task.wait(0.08)

            local Picked = false
            for _ = 1, 3 do
                if not Config.AutoSteal or Config.Stop then break end
                Picked = PickupEgg(BestEgg)
                if Picked then break end
                task.wait(0.12)
            end

            if Picked then
                task.wait(0.1)
                ReturnHome()
            else
                task.wait(0.25)
            end

            task.wait(0.15)
        end
        Config.Busy = false
    end)
end

